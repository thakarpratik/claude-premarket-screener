# ---------------------------------------------------------------------------
# Market Pullback Radar backend configuration. Copy to .env (never commit it).
# All credentials stay on the server; the browser never sees them.
# ---------------------------------------------------------------------------

# demo = labelled synthetic data. live = real market data.
DATA_MODE=demo

# Live price source: auto (Polygon if POLYGON_API_KEY is set, otherwise Yahoo), polygon, or yahoo.
# Yahoo Finance is free and needs no key, but is unofficial and for PERSONAL use only.
PRICE_PROVIDER=auto
YAHOO_DELAY_MINUTES=15
YAHOO_REQUESTS_PER_MINUTE=300

# PostgreSQL in production. Omit to use a local SQLite file (backend/data/pullback_radar.db).
# DATABASE_URL=postgresql://radar:password@localhost:5432/radar

# --- Polygon: licensed prices, reference data, market cap, news (optional; replaces Yahoo when set) ---
# https://polygon.io  — choose a plan with the stocks data you need.
POLYGON_API_KEY=
# Latency of YOUR plan in minutes (0 = real-time, 15 = delayed). Used for honest freshness labels.
POLYGON_DELAY_MINUTES=15
# Free plans allow 5 requests/minute; raise this to match your plan.
POLYGON_REQUESTS_PER_MINUTE=5

# --- Earnings calendar, extra company news, social sentiment (premium) ---
# https://finnhub.io
FINNHUB_API_KEY=
FINNHUB_REQUESTS_PER_MINUTE=30

# --- SEC EDGAR filings (free). EDGAR requires a descriptive User-Agent with contact details.
SEC_USER_AGENT="Your Name your-email@example.com"

# --- Optional AI interpretation of news (labelled as AI in the UI; rules-based classifier otherwise) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Universe ---
# Optional comma-separated list. Empty = Polygon: all liquid common stocks; Yahoo: the built-in list
# of ~120 liquid names (same as Move Radar).
UNIVERSE_SYMBOLS=
# Deep-scan at most this many of the most liquid names per run (controls API usage).
MAX_CANDIDATES=250

# --- Server ---
SCHEDULER_ENABLED=true
ALLOW_REGISTRATION=true
# Set true behind HTTPS so the session cookie is only sent over TLS.
COOKIE_SECURE=false
SESSION_DAYS=14
CORS_ORIGINS=http://localhost:3000
# CACHE_DIR=./data/cache
# UPLOAD_DIR=./data/uploads
